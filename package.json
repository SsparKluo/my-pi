{
	"name": "@ssparkluo/my-pi",
	"version": "0.1.0",
	"description": "A collection of pi extensions for an enhanced coding experience",
	"license": "MIT",
	"dependencies": {
		"minimatch": "10.2.5",
		"unbash": "4.0.8"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/SsparKluo/my-pi.git"
	},
	"files": [
		"editor.ts",
		"request-logger.ts",
		"shortcuts.ts",
		"429-retry.ts",
		"startup-header.ts",
		"system-prompt.ts",
		"system-prompt-core.ts",
		"system-prompt-env.ts",
		"status/",
		"tool-display/",
		"pi-mode/"
	],
	"pi": {
		"extensions": [
			"./editor.ts",
			"./request-logger.ts",
			"./shortcuts.ts",
			"./429-retry.ts",
			"./startup-header.ts",
			"./system-prompt.ts",
			"./status/",
			"./tool-display/",
			"./pi-mode/src/index.ts"
		]
