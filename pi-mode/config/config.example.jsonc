// pi-mode — ~/.pi/agent/pi-mode-config.jsonc
//
// Written on first load. Ships normal / plan / yolo / auto.
// Modes are standalone by default: what you write is what applies.
// `extends: "<mode>"` explicitly inherits a parent's permission / classify / model policy
// (deep-merged, your keys win); prompts are never inherited.
// Omit `permission` entirely for vanilla pi, no gating at all (that is all `yolo` is).
// `defaultMode` is the startup mode (--pi-mode flag and persisted session state override it).
// bash: bash-classify grades, byClass/byRisk pick the verdict; "model" defers to the small LLM.
// last-match-wins: later keys overwrite (e.g. "*": "classify", "rm *": "ask").

{
  "defaultMode": "normal",
  "commandWrappers": ["rtk", "time", "nice", "command"],
  "bashClassify": {
    "engine": "builtin",
    "command": "bash-classify",
    "byRisk": { "LOW": "allow", "MEDIUM": "ask", "HIGH": "ask" },
    "byClass": {
      "READONLY": "allow",
      "LOCAL_EFFECTS": "allow",
      "EXTERNAL_EFFECTS": "ask",
      "DANGEROUS": "ask",
      "UNKNOWN": "ask"
    },
    "fallback": "ask"
  },
  "model": {
    "model": "anthropic/claude-haiku-4-5",
    // "fallbackModels": ["openai/gpt-5-mini"],   // tried in order when the primary fails
    "verdicts": ["allow", "deny"],
    "fallback": "deny",
    "cache": true
    // modes can override verdicts/fallback (see auto: never-deny classifier)
  },
  "modes": {
    // Gated baseline: in-workspace tools allowed (except reading .env), bash graded.
    "normal": {
      "onEnterPrompt": null,
      "onExitPrompt": null,
      "perTurnPrompt": null,
      "permission": {
        "*": "allow",
        "read": {
          "*": "allow",
          "*.env": "ask",
          "*.env.*": "ask",
          "*.env.example": "allow"
        },
        "externalPath": {
          "*": "ask",
          "~/.agents/skills/**": "allow",
          "/dev/null": "allow",
          "/tmp/**": "allow"
        },
        "bash": "classify"
      }
    },
    // Planning: write/edit denied except markdown notes; bash READONLY allows,
    // everything else asks (overrides normal's LOCAL_EFFECTS allow).
    // internal: hidden from selector/cycle, /mode and --pi-mode reject it —
    // reserved for a future /plan command.
    "plan": {
      "extends": "normal",
      "internal": true,
      "onEnterPrompt": null,
      "onExitPrompt": null,
      "perTurnPrompt": null,
      "classify": {
        "byClass": {
          "LOCAL_EFFECTS": "ask",
          "EXTERNAL_EFFECTS": "ask",
          "DANGEROUS": "ask",
          "UNKNOWN": "ask"
        }
      },
      "permission": {
        "write": { "*": "deny", "**/*.md": "allow" },
        "edit": { "*": "deny", "**/*.md": "allow" }
      }
    },
    // No permission block = no gating, nothing ever asks. True yolo.
    "yolo": {},
    // Hands-off: risky bash goes to the small LLM instead of asking; rm still asks
    // (a leading sudo/doas is stripped first, so `sudo rm …` also matches "rm *").
    // The classifier may only answer allow/ask — never deny — and falls back to
    // asking when the model chain fails, so auto never hard-denies.
    "auto": {
      "extends": "normal",
      "onEnterPrompt": null,
      "onExitPrompt": null,
      "perTurnPrompt": null,
      "classify": {
        "byClass": {
          "EXTERNAL_EFFECTS": "model",
          "DANGEROUS": "model",
          "UNKNOWN": "model"
        },
        "byRisk": { "LOW": "allow", "MEDIUM": "model", "HIGH": "model" }
      },
      "model": { "verdicts": ["allow", "ask"], "fallback": "ask" },
      "permission": {
        "bash": { "*": "classify", "rm": "ask", "rm *": "ask" },
        // external access judged by the classifier too (skills/tmp allowlist
        // from normal still wins — last-match-wins keeps it after "*")
        "externalPath": { "*": "model" }
      }
    }
  }
}

// ── Schema ──────────────────────────────────────────────────────────
//
// surfaces:  bash | read | write | edit | grep | find | ls | externalPath | *
// actions:   allow | deny | ask | classify | model
// classify:  grade via bash-classify, then byClass/byRisk pick the verdict.
//            sudo/doas-prefixed units are pattern-matched on their inner command
//            (`sudo rm …` matches "rm *"); eval/bash -c/$(…)/compound and
//            unparseable commands grade like any other unit (UNKNOWN when the
//            grader cannot see inside), so they reach the model in auto.
// model:     defer straight to the small LLM, any surface — a bash unit or a file
//            path (e.g. "read": { "*.env": "model" }); no grader involved.
// grade verdicts (byClass/byRisk values): allow | deny | ask | model
//            "model" = defer that unit to the small LLM (model.verdicts picks its answers;
//            omit "deny" for a never-deny classifier, e.g. auto's allow/ask).
// value:     "<action>"  or  { "<pattern>": "<action>", ... }   (last-match-wins)
// bash/tool patterns = command-prefix globs ("git push *")
// write/edit/externalPath = file-path globs ("**/*.md"); externalPath only gates paths outside cwd
// omit permission    = no gating (vanilla pi / prompt-only)
// extends "<mode>"    = inherit that mode's permission / classify / model, then override
// no matching rule   = deny (fail-closed): every gated mode needs a "*" baseline
